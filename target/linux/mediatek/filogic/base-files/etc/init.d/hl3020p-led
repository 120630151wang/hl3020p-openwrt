#!/bin/sh /etc/rc.common

USE_PROCD=1
START=97
STOP=10

. /lib/functions/system.sh

service_triggers()
{
	procd_add_reload_trigger "hl3020p-led"
}

start_service()
{
	case "$(board_name)" in
		hl,hl3020p-rgb|hl,hl3020p-leds) ;;
		*) return 0 ;;
	esac

	procd_open_instance
	procd_set_param command /usr/sbin/hl3020p-led daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
